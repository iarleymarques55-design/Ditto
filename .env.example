# Usado só pelo docker-compose.yml. Copie para .env (o .env nunca vai para o git).

# Senha do banco que o Docker cria. Gere com: python -c "import secrets; print(secrets.token_urlsafe(24))"
DITTO_DB_PASSWORD=troque-aqui

# A extensão do Ditto carregada no seu Chrome. O id aparece em chrome://extensions
# O ID é fixo (vem da chave em extension/manifest.json): é o mesmo em qualquer computador
DITTO_EXTENSION_ORIGINS=["chrome-extension://kgnecihkofjmeingdbebfimggnaompic"]

# Opcional: login com Google no painel (é público, não é segredo)
VITE_GOOGLE_CLIENT_ID=