# Copie para .env e troque os valores. O .env nunca vai para o git.

# Se a senha tiver caracteres como @ : / #, escreva-os codificados (ex.: @ vira %40).
DATABASE_URL=postgresql+psycopg://postgres:troque-aqui@localhost:5432/ditto

# Banco separado, usado só pelos testes (ele é apagado e recriado a cada execução)
TEST_DATABASE_URL=postgresql+psycopg://postgres:troque-aqui@localhost:5432/ditto_test

# development ou production (em production o /docs fica desligado)
ENVIRONMENT=development

# Origens que podem chamar a API pelo navegador, em formato JSON
CORS_ORIGINS=["http://localhost:5173"]

# Assina os tokens de login. Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-aqui-por-pelo-menos-32-caracteres

# Criptografa as senhas dos portais. Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Para trocar a chave, coloque a nova na frente, separada por vírgula, e mantenha a antiga.
FERNET_KEYS=troque-aqui

# Opcional: login com Google. O mesmo valor de VITE_GOOGLE_CLIENT_ID no frontend.
GOOGLE_CLIENT_ID=

# Opcional: IA (qualquer API compatível com OpenAI). Sem chave, a análise usa regras simples
# e o reparo que dependeria da IA vira um pedido de ajuda no painel.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=

# Opcional: alertas por e-mail. Sem chave, o aviso fica só no painel.
BREVO_API_KEY=
EMAIL_FROM=
PANEL_URL=http://localhost:5173

# A repetição roda sem abrir janela. Para ver o navegador trabalhando no seu computador, use false.
BROWSER_HEADLESS=true
