# Copie para .env e troque os valores. O .env nunca vai para o git.

# Se a senha tiver caracteres como @ : / #, escreva-os codificados (ex.: @ vira %40).
DATABASE_URL=postgresql+psycopg://postgres:troque-aqui@localhost:5432/ditto

# Banco separado, usado só pelos testes (ele é apagado e recriado a cada execução)
TEST_DATABASE_URL=postgresql+psycopg://postgres:troque-aqui@localhost:5432/ditto_test

# development ou production (em production o /docs fica desligado)
ENVIRONMENT=development

# Origens que podem chamar a API pelo navegador, em formato JSON
CORS_ORIGINS=["http://localhost:5173"]

# Quantos proxies ficam na frente da API: 0 no seu computador e no Docker, 1 no Railway.
# Serve para o limite de tentativas de login contar por pessoa, e não pelo IP do proxy.
TRUSTED_PROXY_HOPS=0

# Assina os tokens de login. Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-aqui-por-pelo-menos-32-caracteres

# Criptografa as senhas dos portais. Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Para trocar a chave, coloque a nova na frente, separada por vírgula, e mantenha a antiga.
FERNET_KEYS=troque-aqui

# Opcional: login com Google. O mesmo valor de VITE_GOOGLE_CLIENT_ID no frontend.
GOOGLE_CLIENT_ID=

# Opcional: IA (qualquer API compatível com OpenAI). Sem chave, a análise usa regras simples
# e o reparo que dependeria da IA vira um pedido de ajuda no painel.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
# "Criar com IA": limite de passos e quanto esperar você responder uma dúvida (segundos)
AI_DRAFT_MAX_STEPS=40
AI_DRAFT_ANSWER_TIMEOUT_SECONDS=600

# Opcional: alertas por e-mail. Sem chave, o aviso fica só no painel.
BREVO_API_KEY=
EMAIL_FROM=
PANEL_URL=http://localhost:5173

# Arquivos gerados (downloads das tarefas, telas, fotos). Vazio: ficam na pasta storage/ do disco,
# o que basta quando a API e o worker dividem a pasta (seu computador, Docker). No Railway, a API
# e o worker ficam em máquinas separadas: crie um bucket e preencha os quatro campos abaixo.
S3_BUCKET=
# Vazio usa a AWS. Para Railway, Cloudflare R2 ou MinIO, o endereço que eles informam
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Sem a extensão: quantas execuções rodam ao mesmo tempo, cada uma com o seu navegador.
WORKER_CONCURRENCY=1
# Com a extensão: quantas contas o worker atende ao mesmo tempo (cada uma em paralelo).
WORKER_MAX_ACCOUNTS=20

# A repetição roda sem abrir janela. Para ver o navegador trabalhando no seu computador, use false.
BROWSER_HEADLESS=true

# Opcional: rodar as tarefas no Chrome de cada pessoa, pela extensão, em abas ao lado das dela
# e com as contas logadas nele. Use 8765 (a porta que a extensão procura) e conecte na página
# da conta. No Railway, use a porta que ele informa.
EXTENSION_RUNNER_PORT=
# Onde a porta da extensão escuta: 127.0.0.1 no seu computador; 0.0.0.0 em container ou no
# Ditto publicado. O lado do Playwright sempre fica preso a esta máquina.
EXTENSION_RELAY_HOST=127.0.0.1
# Extensões aceitas, em JSON: ["chrome-extension://<id da extensão>"]. Obrigatório quando
# EXTENSION_RELAY_HOST não é 127.0.0.1. O id aparece em chrome://extensions.
EXTENSION_ORIGINS=[]
